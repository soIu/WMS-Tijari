<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="api_scheduler_master_data" model="api.scheduler.job">
            <field name="name">Acumatica: Master Data</field>
            <field name="code">acumatica_master_fetch</field>
            <field name="description">Fetch and import Acumatica master data.</field>
            <field name="active">True</field>
            <field name="acumatica_import">True</field>
            <field name="acumatica_data_type">master</field>
            <field name="process_phase">fetch</field>
            <field name="execution_interval">recurring</field>
            <field name="interval_value">1</field>
            <field name="interval_unit">days</field>
            <field name="timezone">Asia/Jakarta</field>
            <field name="do_not_overlap">True</field>
        </record>

        <record id="api_scheduler_transaction_data" model="api.scheduler.job">
            <field name="name">Acumatica: Transaction Data</field>
            <field name="code">acumatica_transaction_fetch</field>
            <field name="description">Fetch Acumatica transaction data into staging.</field>
            <field name="active">True</field>
            <field name="acumatica_import">True</field>
            <field name="acumatica_data_type">transaction</field>
            <field name="process_phase">fetch</field>
            <field name="execution_interval">recurring</field>
            <field name="interval_value">1</field>
            <field name="interval_unit">days</field>
            <field name="timezone">Asia/Jakarta</field>
            <field name="do_not_overlap">True</field>
        </record>

        <function model="ir.model.data" name="write">
            <value model="ir.model.data" search="[('module', '=', 'acumatica_all_import'), ('name', '=', 'ir_cron_acumatica_master_data_import')]"/>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="ir_cron_acumatica_master_data_import" model="ir.cron">
            <field name="name">Acumatica: Fetch Master Data</field>
            <field name="model_id" ref="model_api_scheduler_job"/>
            <field name="state">code</field>
            <field name="code">model.browse(env.ref('acumatica_all_import.api_scheduler_master_data').id).run_from_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="ir_cron_acumatica_transaction_data_import" model="ir.cron">
            <field name="name">Acumatica: Fetch Transaction Data</field>
            <field name="model_id" ref="model_api_scheduler_job"/>
            <field name="state">code</field>
            <field name="code">model.browse(env.ref('acumatica_all_import.api_scheduler_transaction_data').id).run_from_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="api_scheduler_master_data" model="api.scheduler.job">
            <field name="ir_cron_id" ref="ir_cron_acumatica_master_data_import"/>
        </record>

        <record id="api_scheduler_transaction_data" model="api.scheduler.job">
            <field name="ir_cron_id" ref="ir_cron_acumatica_transaction_data_import"/>
        </record>

        <record id="api_scheduler_master_import" model="api.scheduler.job">
            <field name="name">Acumatica: Import Master Data</field>
            <field name="code">acumatica_master_import</field>
            <field name="description">Import master staging data after the fetch job succeeds.</field>
            <field name="active">True</field>
            <field name="acumatica_import">True</field>
            <field name="acumatica_data_type">master</field>
            <field name="process_phase">import</field>
            <field name="execution_interval">recurring</field>
            <field name="interval_value">1</field>
            <field name="interval_unit">days</field>
            <field name="timezone">Asia/Jakarta</field>
            <field name="do_not_overlap">True</field>
        </record>

        <record id="ir_cron_acumatica_master_import" model="ir.cron">
            <field name="name">Acumatica: Import Master Data</field>
            <field name="model_id" ref="model_api_scheduler_job"/>
            <field name="state">code</field>
            <field name="code">model.browse(env.ref('acumatica_all_import.api_scheduler_master_import').id).run_from_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="api_scheduler_master_import" model="api.scheduler.job">
            <field name="ir_cron_id" ref="ir_cron_acumatica_master_import"/>
        </record>

        <record id="api_scheduler_transaction_import" model="api.scheduler.job">
            <field name="name">Acumatica: Import Transaction Data</field>
            <field name="code">acumatica_transaction_import</field>
            <field name="description">Import transaction staging data after fetch completes.</field>
            <field name="active">True</field>
            <field name="acumatica_import">True</field>
            <field name="acumatica_data_type">transaction</field>
            <field name="process_phase">import</field>
            <field name="execution_interval">manual</field>
            <field name="interval_value">1</field>
            <field name="interval_unit">days</field>
            <field name="timezone">Asia/Jakarta</field>
            <field name="do_not_overlap">True</field>
        </record>

        <record id="ir_cron_acumatica_transaction_import" model="ir.cron">
            <field name="name">Acumatica: Import Transaction Data</field>
            <field name="model_id" ref="model_api_scheduler_job"/>
            <field name="state">code</field>
            <field name="code">model.browse(env.ref('acumatica_all_import.api_scheduler_transaction_import').id).run_from_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="api_scheduler_transaction_import" model="api.scheduler.job">
            <field name="ir_cron_id" ref="ir_cron_acumatica_transaction_import"/>
        </record>

        <record id="api_scheduler_webhook_process" model="api.scheduler.job">
            <field name="name">Acumatica: Process Pending Webhook Logs</field>
            <field name="code">acumatica_webhook_process</field>
            <field name="description">Process pending Acumatica webhook logs.</field>
            <field name="active">False</field>
            <field name="execution_interval">recurring</field>
            <field name="interval_value">5</field>
            <field name="interval_unit">minutes</field>
            <field name="timezone">Asia/Jakarta</field>
            <field name="do_not_overlap">True</field>
        </record>

        <record id="ir_cron_acumatica_process_pending_webhook_logs" model="ir.cron">
            <field name="name">Acumatica: Process Pending Webhook Logs</field>
            <field name="model_id" ref="model_api_scheduler_job"/>
            <field name="state">code</field>
            <field name="code">model.browse(env.ref('acumatica_all_import.api_scheduler_webhook_process').id).run_from_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="api_scheduler_webhook_process" model="api.scheduler.job">
            <field name="ir_cron_id" ref="ir_cron_acumatica_process_pending_webhook_logs"/>
        </record>
    </data>
</odoo>
