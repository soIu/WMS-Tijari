<odoo>

    <record id="tijari_package_level_detail_wizard_view_form" model="ir.ui.view">
        <field name="name">package.level.detail.wizard.form</field>
        <field name="model">package.level.detail.wizard</field>
        <field name="arch" type="xml">

            <form create="false" edit="false">

                <group class="grid-container">
                    <field name="package_level_id" invisible='1' />
                    <field name="package_id"/>
                    <field name="package_cat"/>
                    <field 
                        name="status"
                        widget="badge"
                        decoration-success="status == 'finished'"
                        decoration-danger="status == 'unfinished'" 
                    />
                </group>

                <field name="move_line_ids" class="package-level-detail-lines">
                    <list create="false" delete="false" edit="false">
                        <field 
                            name="product_id"
                            context="{'tijari_stock_picking_product_code_only': False}"/>
                        <field name="description_picking" string="Description"/>
                        <field name="quantity"/>
                        <field name="product_uom_id" string="UoM"/>
                    </list>
                    <kanban create="false" delete="false" edit="false" class="o_package_level_kanban">
                        <field name="product_id"/>
                        <field name="description_picking"/>
                        <field name="quantity"/>
                        <field name="product_uom_id"/>
                        <templates>
                            <t t-name="card" class="o_package_level_card">
                                <div class="o_package_level_card_title">
                                    <strong>
                                        <t t-esc="record.product_id.value"/>
                                    </strong>
                                </div>
                                
                                <div class="o_package_level_card_qty">
                                    Qty Dikirim :
                                    <field name="quantity"/>
                                    <span class="ms-2"><field name="product_uom_id"/></span>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>

                <footer>
                    <button
                        name="action_mark_finished"
                        type="object"
                        string="Confirm &amp; Save"
                        class="btn-primary"
                        invisible="status == 'finished'"
                    />

                    <button 
                        name="action_mark_unfinished"
                        type="object"
                        string="Rollback"
                        class="btn-danger"
                        invisible="status != 'finished'"/>
                    
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>
    </record>

</odoo>
