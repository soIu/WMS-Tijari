<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Keep Document Only pickings out of Odoo's standard Transfers menus.
         The picking flag is the primary marker; picking-type and location
         flags also catch records whose picking flag was not synchronized. -->
    <record id="stock.action_picking_tree_incoming" model="ir.actions.act_window">
        <field name="domain">[
            ('adt_is_document_only', '=', False),
            ('picking_type_id.is_document_only_api', '=', False),
        ]</field>
        <field name="context">{'search_default_tijari_receive': 1, 'search_default_my_transfers': 1}</field>
    </record>

    <record id="stock.action_picking_tree_outgoing" model="ir.actions.act_window">
        <field name="domain">[
            ('adt_is_document_only', '=', False),
            ('picking_type_id.is_document_only_api', '=', False),
        ]</field>
        <field name="context">{'search_default_tijari_delivery': 1, 'search_default_my_transfers': 1}</field>
    </record>

    <record id="action_wms_operations_purchase_receipts" model="ir.actions.act_window">
        <field name="name">Purchase Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('tijari_wms_18.group_operator'), ref('stock.group_stock_manager'), ref('base.group_system')])]"/>
        <field name="domain">[
            ('picking_type_id.code', '=', 'incoming'),
            ('adt_type', '=', 'Receipt'),
        ('adt_is_document_only', '=', False),
        ]</field>
    </record>

