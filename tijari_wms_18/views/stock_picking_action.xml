<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_stock_picking_acumatica_error" model="ir.actions.act_window">
      <field name="name">Picking Import Errors</field>
      <field name="res_model">stock.picking.acumatica.error</field>
      <field name="view_mode">list,form</field>
  </record>

  <record id="action_scan_stock_picking_by_origin" model="ir.actions.client">
      <field name="name">Search Document</field>
      <field name="tag">adt_scan_qr_to_picking_origin</field>
      <field name="params" eval="{'title': 'Search Document'}"/>
  </record>

  <record id="action_stock_picking_my_worklist" model="ir.actions.act_window">
      <field name="name">My Worklist</field>
      <field name="res_model">stock.picking</field>
      <field name="view_mode">kanban,list,form</field>
        <field name="domain">
            [
                '&amp;', ('state', '!=', 'draft'),
                '|', '|', '|', '|',
                '&amp;', ('putaway_responsible_ids', 'in', [uid]),
                    ('picking_type_name', 'in', ['Receipts', 'Receipt Internal', 'Storage', 'Store Finished Product']),
                '&amp;', ('pick_responsible_ids', 'in', [uid]),
                    ('picking_type_name', 'in', ['Pick', 'Pick Internal', 'Pick Components']),
                '&amp;', ('pick_responsible_ids', 'in', [uid]),
                    ('picking_type_name', 'in', ['Receipts', 'Receipt Internal']),
                '&amp;', ('pack_responsible_ids', 'in', [uid]),
                    ('picking_type_name', '=', 'Pack'),
                '&amp;', ('do_responsible_ids', 'in', [uid]),
                    ('picking_type_name', 'in', ['Delivery Orders'])
            ]
        </field>
        <field name="context">{'group_by': 'picking_type_id', 'tijari_my_worklist': 1}</field>
      <field name="groups_id" eval="[(6, 0, [ref('tijari_wms_18.group_operator'), ref('tijari_wms_18.group_warehouse_manager'), ref('tijari_wms_18.group_warehouse_head'), ref('tijari_wms_18.group_warehouse_admin'), ref('tijari_wms_18.group_it_staff'), ref('stock.group_stock_manager'), ref('base.group_system')])]"/>
  </record>

  <record id="action_stock_picking_my_worklist_overview" model="ir.actions.act_window">
      <field name="name">Overview</field>
      <field name="res_model">stock.picking</field>
      <field name="view_mode">kanban,form</field>
      <field name="domain">[('user_ids', 'in', [uid]), ('state', '!=', 'done')]</field>
      <field name="context">{'group_by': 'picking_type_id'}</field>
      <field name="groups_id" eval="[(6, 0, [ref('tijari_wms_18.group_operator'), ref('tijari_wms_18.group_warehouse_manager'), ref('tijari_wms_18.group_warehouse_head'), ref('tijari_wms_18.group_warehouse_admin'), ref('tijari_wms_18.group_it_staff'), ref('stock.group_stock_manager'), ref('base.group_system')])]"/>
  </record>

</odoo>
